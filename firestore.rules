rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Universal access for application collections
    match /{document=**} {
      allow read, write: if true;
    }
    
    // Explicit collection matchers
    match /users/{userId} {
      allow read, write: if true;
    }
    match /leads/{leadId} {
      allow read, write: if true;
    }
    match /associates/{associateId} {
      allow read, write: if true;
    }
    match /members/{memberId} {
      allow read, write: if true;
    }
    match /ventures/{ventureId} {
      allow read, write: if true;
    }
    match /events/{eventId} {
      allow read, write: if true;
    }
    match /plots/{plotId} {
      allow read, write: if true;
    }
    match /ecDocuments/{docId} {
      allow read, write: if true;
    }
    match /membershipCards/{cardId} {
      allow read, write: if true;
    }
    match /membership_cards/{cardId} {
      allow read, write: if true;
    }
    match /nriTiers/{tierId} {
      allow read, write: if true;
    }
    match /hospitalityItems/{itemId} {
      allow read, write: if true;
    }
    match /hospitality/{itemId} {
      allow read, write: if true;
    }
    match /app_ads/{adId} {
      allow read, write: if true;
    }
    match /auditLogs/{logId} {
      allow read, write: if true;
    }
  }
}

